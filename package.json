{
  "name": "mana-vortexscans",
  "version": "1.0.0",
  "repositoryName": "VortexScans for Mana",
  "description": "VortexScans extension for Mana.",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "prep": "rm -rf ./lib && tsc",
    "dev": "nodemon",
    "build": "mana-dev build",
    "serve": "mana-dev serve",
    "lint": "eslint 'src/**/*.ts'",
    "test:report": "node --test scripts/*.test.mjs",
    "test:extensions": "node scripts/live-tests.mjs",
    "update:test-status": "node scripts/test-status.mjs publish",
    "verify:bundles": "node scripts/verify-bundles.mjs",
    "test:local": "node scripts/local-live-tests.mjs"
  },
  "author": {
    "name": "Lucifers Circle",
    "url": "https://github.com/LucifersCircle"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@mana-app/dev": "0.2.0",
    "@tsconfig/recommended": "^1.0.1",
    "@types/jest": "^29.2.4",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.57.1",
    "@types/cheerio": "^0.22.35",
    "eslint": "^7.27.0",
    "eslint-plugin-modules-newline": "^0.0.6",
    "jest": "^29.3.1",
    "nodemon": "^2.0.22",
    "ts-jest": "^29.0.3",
    "ts-node": "^10.2.1",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@mana-app/types": "0.1.0",
    "cheerio": "1.0.0-rc.12",
    "crypto-es": "2.1.0",
    "html-entities": "^2.5.2"
  },
  "mana": {
    "repositoryName": "Pirate Vodka Extensions",
    "thumbnail": "https://avatars.githubusercontent.com/LucifersCircle"
  },
  "type": "module"
}
